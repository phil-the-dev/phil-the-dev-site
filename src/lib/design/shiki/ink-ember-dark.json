  "semanticTokenColors": {
    "namespace": "#68B4E0",
    "class": "#68B4E0",
    "interface": { "foreground": "#68B4E0", "italic": true },
    "enum": "#68B4E0",
    "typeParameter": { "foreground": "#68B4E0", "italic": true },
    "type": "#68B4E0",
    "struct": "#68B4E0",
    "function": "#D4B142",
    "method": "#D4B142",
    "macro": "#F97A45",
    "decorator": "#D4B142",
    "enumMember": "#C89BD6",
    "property": "#E7E3DD",
    "variable": "#E7E3DD",
    "variable.readonly": "#C89BD6",
    "variable.defaultLibrary": "#68B4E0",
    "parameter": "#CE7C92",
    "keyword": "#F97A45",
    "string": "#79BE8B",
    "number": "#C89BD6",
    "regexp": "#CE7C92",
    "operator": "#948D85",
    "comment": { "foreground": "#948D85", "italic": true },
    "*.deprecated": { "strikethrough": true, "foreground": "#CE7C92" },
    "*.declaration": { "bold": true }
  },

  "tokenColors": [
    {
      "name": "Comments — Smoke",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#948D85", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment keywords",
      "scope": ["comment.block.documentation storage.type", "keyword.other.documentation"],
      "settings": { "foreground": "#948D85", "fontStyle": "italic bold" }
    },
    {
      "name": "Keywords, storage, control flow — Ember Glow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super",
        "keyword.other.important"
      ],
      "settings": { "foreground": "#F97A45" }
    },
    {
      "name": "Strings — Moss Glow",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "meta.embedded.line",
        "constant.other.symbol"
      ],
      "settings": { "foreground": "#79BE8B" }
    },
    {
      "name": "Template expression punctuation returns to keyword",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#F97A45" }
    },
    {
      "name": "Numbers, constants, booleans — Dusk Glow",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": { "foreground": "#C89BD6" }
    },
    {
      "name": "Functions and methods — Tallow Glow",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#D4B142" }
    },
    {
      "name": "Types, classes, interfaces — Inkwell Glow",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "meta.type.annotation entity.name.type",
        "entity.name.scope-resolution"
      ],
      "settings": { "foreground": "#68B4E0" }
    },
    {
      "name": "Built-in / library types stay Inkwell but italic",
      "scope": ["support.type.primitive", "support.type.builtin", "entity.name.type.interface"],
      "settings": { "foreground": "#68B4E0", "fontStyle": "italic" }
    },
    {
      "name": "Variables and properties — Paper Dim",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.other.property"
      ],
      "settings": { "foreground": "#E7E3DD" }
    },
    {
      "name": "Parameters, regex, escapes — Claret Glow",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "string.regexp",
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": { "foreground": "#CE7C92" }
    },
    {
      "name": "Punctuation and operators — Smoke",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#948D85" }
    },
    {
      "name": "HTML / JSX tags — Ember Glow",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": { "foreground": "#F97A45" }
    },
    {
      "name": "JSX components read as types",
      "scope": [
        "support.class.component",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": { "foreground": "#68B4E0" }
    },
    {
      "name": "Attributes — Tallow Glow",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute entity.other.attribute-name"
      ],
      "settings": { "foreground": "#D4B142" }
    },
    {
      "name": "CSS selectors and properties",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#D4B142" }
    },
    {
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": { "foreground": "#E7E3DD" }
    },
    {
      "scope": ["support.constant.property-value.css", "constant.other.color"],
      "settings": { "foreground": "#79BE8B" }
    },
    {
      "name": "CSS custom properties — the brand tokens themselves",
      "scope": ["variable.css", "variable.argument.css", "support.type.custom-property.name.css"],
      "settings": { "foreground": "#C89BD6" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#68B4E0" }
    },
    {
      "name": "YAML / TOML keys",
      "scope": ["entity.name.tag.yaml", "variable.other.key.toml", "keyword.key.toml"],
      "settings": { "foreground": "#68B4E0" }
    },
    {
      "name": "Markdown headings — Ember Glow",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading"],
      "settings": { "foreground": "#F97A45", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E7E3DD", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#E7E3DD", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#79BE8B" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "markup.link"],
      "settings": { "foreground": "#68B4E0", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.quote", "beginning.punctuation.definition.quote.markdown"],
      "settings": { "foreground": "#948D85", "fontStyle": "italic" }
    },
    {
      "scope": ["beginning.punctuation.definition.list.markdown", "markup.list"],
      "settings": { "foreground": "#D4B142" }
    },
    {
      "name": "Diff — semantic set",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#79BE8B" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#F87F8C" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#D4B142" }
    },
    {
      "name": "Invalid — Signal Glow",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#F87F8C" }
    },
    {
      "name": "Deprecated — Claret Glow, struck through",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#CE7C92", "fontStyle": "strikethrough" }
    },
    {
      "name": "Shell — commands read as keywords, flags as parameters",
      "scope": ["source.shell support.function", "source.shell keyword.other"],
      "settings": { "foreground": "#F97A45" }
    },
    {
      "scope": ["source.shell string.unquoted.argument", "constant.other.option"],
      "settings": { "foreground": "#CE7C92" }
    },
    {
      "name": "Git commit summary",
      "scope": ["meta.scope.prelude.diff", "text.git-commit meta.scope.metadata"],
      "settings": { "foreground": "#948D85" }
    }
  ]
}
