  "semanticTokenColors": {
    "namespace": "#245C86",
    "class": "#245C86",
    "interface": { "foreground": "#245C86", "italic": true },
    "enum": "#245C86",
    "typeParameter": { "foreground": "#245C86", "italic": true },
    "type": "#245C86",
    "struct": "#245C86",
    "function": "#7F6A16",
    "method": "#7F6A16",
    "macro": "#BE4517",
    "decorator": "#7F6A16",
    "enumMember": "#6A3D7C",
    "property": "#2A2724",
    "variable": "#2A2724",
    "variable.readonly": "#6A3D7C",
    "variable.defaultLibrary": "#245C86",
    "parameter": "#8B2A3E",
    "keyword": "#BE4517",
    "string": "#2F5B3A",
    "number": "#6A3D7C",
    "regexp": "#8B2A3E",
    "operator": "#5C5750",
    "comment": { "foreground": "#5C5750", "italic": true },
    "*.deprecated": { "strikethrough": true, "foreground": "#8B2A3E" },
    "*.declaration": { "bold": true }
  },

  "tokenColors": [
    {
      "name": "Comments — Stone",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#5C5750", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment keywords",
      "scope": ["comment.block.documentation storage.type", "keyword.other.documentation"],
      "settings": { "foreground": "#5C5750", "fontStyle": "italic bold" }
    },
    {
      "name": "Keywords, storage, control flow — Ember",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super",
        "keyword.other.important"
      ],
      "settings": { "foreground": "#BE4517" }
    },
    {
      "name": "Strings — Moss",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "meta.embedded.line",
        "constant.other.symbol"
      ],
      "settings": { "foreground": "#2F5B3A" }
    },
    {
      "name": "Template expression punctuation returns to keyword",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#BE4517" }
    },
    {
      "name": "Numbers, constants, booleans — Dusk",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": { "foreground": "#6A3D7C" }
    },
    {
      "name": "Functions and methods — Tallow",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": { "foreground": "#7F6A16" }
    },
    {
      "name": "Types, classes, interfaces — Inkwell",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "meta.type.annotation entity.name.type",
        "entity.name.scope-resolution"
      ],
      "settings": { "foreground": "#245C86" }
    },
    {
      "name": "Built-in / library types stay Inkwell but italic",
      "scope": ["support.type.primitive", "support.type.builtin", "entity.name.type.interface"],
      "settings": { "foreground": "#245C86", "fontStyle": "italic" }
    },
    {
      "name": "Variables and properties — Ink",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.other.property"
      ],
      "settings": { "foreground": "#2A2724" }
    },
    {
      "name": "Parameters, regex, escapes — Claret",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "string.regexp",
        "constant.character.escape",
        "constant.regexp"
      ],
      "settings": { "foreground": "#8B2A3E" }
    },
    {
      "name": "Punctuation and operators — Stone",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": { "foreground": "#5C5750" }
    },
    {
      "name": "HTML / JSX tags — Ember",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag"],
      "settings": { "foreground": "#BE4517" }
    },
    {
      "name": "JSX components read as types",
      "scope": ["support.class.component", "entity.name.tag.jsx", "entity.name.tag.tsx"],
      "settings": { "foreground": "#245C86" }
    },
    {
      "name": "Attributes — Tallow",
      "scope": ["entity.other.attribute-name", "meta.attribute entity.other.attribute-name"],
      "settings": { "foreground": "#7F6A16" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#7F6A16" }
    },
    {
      "scope": ["support.type.property-name.css", "support.type.property-name.scss"],
      "settings": { "foreground": "#2A2724" }
    },
    {
      "scope": ["support.constant.property-value.css", "constant.other.color"],
      "settings": { "foreground": "#2F5B3A" }
    },
    {
      "name": "CSS custom properties — the brand tokens themselves",
      "scope": ["variable.css", "variable.argument.css", "support.type.custom-property.name.css"],
      "settings": { "foreground": "#6A3D7C" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#245C86" }
    },
    {
      "name": "YAML / TOML keys",
      "scope": ["entity.name.tag.yaml", "variable.other.key.toml", "keyword.key.toml"],
      "settings": { "foreground": "#245C86" }
    },
    {
      "name": "Markdown headings — Ember",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading"],
      "settings": { "foreground": "#BE4517", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#1A1817", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#2A2724", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#2F5B3A" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "markup.link"],
      "settings": { "foreground": "#245C86", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.quote", "beginning.punctuation.definition.quote.markdown"],
      "settings": { "foreground": "#5C5750", "fontStyle": "italic" }
    },
    {
      "scope": ["beginning.punctuation.definition.list.markdown", "markup.list"],
      "settings": { "foreground": "#7F6A16" }
    },
    {
      "name": "Diff — semantic set",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#2F5B3A" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#C21F33" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#7F6A16" }
    },
    {
      "name": "Invalid — Signal",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C21F33" }
    },
    {
      "name": "Deprecated — Claret, struck through",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#8B2A3E", "fontStyle": "strikethrough" }
    },
    {
      "name": "Shell — commands read as keywords, flags as parameters",
      "scope": ["source.shell support.function", "source.shell keyword.other"],
      "settings": { "foreground": "#BE4517" }
    },
    {
      "scope": ["source.shell string.unquoted.argument", "constant.other.option"],
      "settings": { "foreground": "#8B2A3E" }
    },
    {
      "name": "Git commit summary",
      "scope": ["meta.scope.prelude.diff", "text.git-commit meta.scope.metadata"],
      "settings": { "foreground": "#5C5750" }
    }
  ]
}
